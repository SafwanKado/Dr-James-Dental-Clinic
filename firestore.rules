rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 0. GLOBAL SAFETY NET: Default-Deny Catch-All
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 1. REUSABLE SECURITY & COMPLIANCE PRIMITIVES
    // =========================================================================
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Verified Doctor / Staff Administrator check (Email Spoofing Guard: requires email_verified == true)
    function isAdmin() {
      return isSignedIn() && (
        (
          request.auth.token.email_verified == true && (
            request.auth.token.email == 'safwankado13@gmail.com' ||
            request.auth.token.email.matches('.*@qadodental\\.com$')
          )
        ) ||
        exists(/databases/$(database)/documents/staff_roles/$(request.auth.uid))
      );
    }

    // =========================================================================
    // 2. APPOINTMENTS COLLECTION (/appointments/{appointmentId})
    //    Allows public patient submission with mandatory TCPA/HIPAA consent.
    //    Restricts PHI access and appointment management to authorized clinic staff.
    // =========================================================================
    function isValidAppointment(data) {
      return data.keys().hasAll([
        'patientName',
        'phoneNumber',
        'services',
        'appointmentDate',
        'timeSlot',
        'status',
        'totalCashEstimated',
        'tcpaConsent',
        'hipaaConsent',
        'createdAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'patientName',
        'phoneNumber',
        'email',
        'services',
        'selectedProducts',
        'appointmentDate',
        'timeSlot',
        'status',
        'totalCashEstimated',
        'lateFeeIncluded',
        'tcpaConsent',
        'hipaaConsent',
        'practitioner',
        'notes',
        'confirmationCode',
        'isNewPatient',
        'createdAt',
        'lastUpdated'
      ]) &&
      (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
      data.patientName is string && data.patientName.size() >= 2 && data.patientName.size() <= 100 &&
      data.phoneNumber is string && data.phoneNumber.size() >= 10 && data.phoneNumber.size() <= 25 &&
      (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
      data.services is list && data.services.size() >= 1 && data.services.size() <= 10 &&
      (!('selectedProducts' in data) || (data.selectedProducts is list && data.selectedProducts.size() <= 20)) &&
      data.appointmentDate is string && data.appointmentDate.size() == 10 &&
      data.timeSlot is string && data.timeSlot.size() >= 4 && data.timeSlot.size() <= 20 &&
      data.status in ['confirmed', 'in_chair', 'completed', 'cancelled'] &&
      data.totalCashEstimated is number && data.totalCashEstimated >= 0 && data.totalCashEstimated <= 50000 &&
      (!('lateFeeIncluded' in data) || (data.lateFeeIncluded is number && data.lateFeeIncluded >= 0 && data.lateFeeIncluded <= 100)) &&
      // Mandatory TCPA and HIPAA regulatory consents
      data.tcpaConsent == true &&
      data.hipaaConsent == true &&
      (!('practitioner' in data) || (data.practitioner is string && data.practitioner.size() <= 100)) &&
      (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
      (!('confirmationCode' in data) || (data.confirmationCode is string && data.confirmationCode.size() <= 20)) &&
      (!('isNewPatient' in data) || data.isNewPatient is bool) &&
      data.createdAt is timestamp &&
      (!('lastUpdated' in data) || data.lastUpdated is timestamp);
    }

    match /appointments/{appointmentId} {
      // Single appointment lookup & listing restricted to verified clinic staff
      allow get: if isValidId(appointmentId) && isAdmin();
      allow list: if isAdmin();

      // Public Patient Booking: Allows patients to book with mandatory TCPA/HIPAA consent & server time
      allow create: if isValidId(appointmentId) &&
                       isValidAppointment(incoming()) &&
                       incoming().status == 'confirmed' &&
                       incoming().createdAt == request.time;

      // Updates restricted to clinic staff (/doctor portal) with immutable createdAt and server lastUpdated
      allow update: if isValidId(appointmentId) &&
                       isAdmin() &&
                       isValidAppointment(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       (!('lastUpdated' in incoming()) || incoming().lastUpdated == request.time) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'status',
                         'lastUpdated',
                         'notes',
                         'totalCashEstimated',
                         'selectedProducts',
                         'services',
                         'appointmentDate',
                         'timeSlot',
                         'practitioner'
                       ]);

      // Deletions restricted strictly to clinic administrator
      allow delete: if isValidId(appointmentId) && isAdmin();
    }

    // =========================================================================
    // 3. PATIENTS COLLECTION (/patients/{patientId})
    //    Document key is normalized phone digits (e.g., 15552348901).
    //    Allows single-doc fee lookup prior to booking; roster list/updates for staff only.
    // =========================================================================
    function isValidPatient(data) {
      return data.keys().hasAll([
        'phoneNumber',
        'fullName',
        'unpaidCancellationFee',
        'feeAmount',
        'lastUpdated'
      ]) &&
      data.keys().hasOnly([
        'phoneNumber',
        'fullName',
        'unpaidCancellationFee',
        'feeAmount',
        'lastUpdated',
        'notes'
      ]) &&
      data.phoneNumber is string && data.phoneNumber.size() >= 10 && data.phoneNumber.size() <= 25 &&
      data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
      data.unpaidCancellationFee is bool &&
      data.feeAmount is number && data.feeAmount >= 0 && data.feeAmount <= 500 &&
      data.lastUpdated is timestamp &&
      (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000));
    }

    match /patients/{patientId} {
      // Exact single-document fee lookup by normalized phone digits
      allow get: if isValidId(patientId);

      // Blanket patient list is restricted to clinic staff to protect patient roster
      allow list: if isAdmin();

      // Create initial patient profile during booking (cannot spoof unpaid fee unless admin)
      allow create: if isValidId(patientId) &&
                       isValidPatient(incoming()) &&
                       incoming().lastUpdated == request.time &&
                       (isAdmin() || (incoming().unpaidCancellationFee == false && incoming().feeAmount == 0));

      // Only clinic staff (or backend Admin SDK) can mark fees paid or assess a $10 cancellation fee
      allow update: if isValidId(patientId) &&
                       isAdmin() &&
                       isValidPatient(incoming()) &&
                       incoming().lastUpdated == request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'fullName',
                         'unpaidCancellationFee',
                         'feeAmount',
                         'lastUpdated',
                         'notes'
                       ]);

      // No deletion allowed
      allow delete: if false;
    }

    // =========================================================================
    // 4. AUDIT LOGS COLLECTION (/audit_logs/{logId})
    //    MANDATORY HIPAA AUDIT TRAIL (§ 164.312(b)): Append-Only & Immutable
    // =========================================================================
    function isValidAuditLog(data) {
      return data.keys().hasAll(['timestamp', 'action', 'performedBy', 'patientId']) &&
             data.keys().hasOnly(['id', 'timestamp', 'action', 'performedBy', 'patientId', 'ipAddress', 'details']) &&
             (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
             data.timestamp == request.time &&
             data.action in ['CREATE', 'CANCEL', 'MARK_PAID', 'STATUS_CHANGE'] &&
             data.performedBy is string && data.performedBy.size() >= 1 && data.performedBy.size() <= 100 &&
             data.patientId is string && data.patientId.size() >= 1 && data.patientId.size() <= 50 &&
             (!('ipAddress' in data) || (data.ipAddress is string && data.ipAddress.size() <= 50)) &&
             (!('details' in data) || data.details is map);
    }

    match /audit_logs/{logId} {
      // Append-Only: Patients can log booking CREATE events; clinic staff can log all actions
      allow create: if isValidId(logId) &&
                       isValidAuditLog(incoming()) &&
                       (isAdmin() || incoming().action == 'CREATE');

      // Read restricted exclusively to clinic staff and compliance officers
      allow get, list: if isAdmin();

      // STRICT IMMUTABILITY: Updating or deleting audit logs is forbidden
      allow update, delete: if false;
    }

    // =========================================================================
    // 5. STAFF ROLES COLLECTION (/staff_roles/{userId})
    // =========================================================================
    match /staff_roles/{userId} {
      allow get: if isValidId(userId) && (isAdmin() || (isSignedIn() && request.auth.uid == userId));
      allow list: if isAdmin();
      allow write: if false;
    }
  }
}
