{
  "entities": {
    "Appointment": {
      "title": "Appointment",
      "description": "Patient booking record for dental procedures with Dr. James Qado",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique appointment identifier",
          "maxLength": 128
        },
        "patientName": {
          "type": "string",
          "description": "Full legal name of the patient",
          "minLength": 2,
          "maxLength": 100
        },
        "phoneNumber": {
          "type": "string",
          "description": "Standardized U.S. mobile phone number (+1)",
          "minLength": 10,
          "maxLength": 25
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Optional patient email address",
          "maxLength": 120
        },
        "services": {
          "type": "array",
          "description": "List of core dental services selected"
        },
        "selectedProducts": {
          "type": "array",
          "description": "Optional oral hygiene products attached to the visit record"
        },
        "appointmentDate": {
          "type": "string",
          "description": "Scheduled date in YYYY-MM-DD format",
          "minLength": 10,
          "maxLength": 10
        },
        "timeSlot": {
          "type": "string",
          "description": "Scheduled appointment time",
          "minLength": 4,
          "maxLength": 20
        },
        "status": {
          "type": "string",
          "description": "Status of the appointment",
          "enum": ["confirmed", "in_chair", "completed", "cancelled"]
        },
        "totalCashEstimated": {
          "type": "number",
          "description": "Total cash fee expected at visit in USD"
        },
        "lateFeeIncluded": {
          "type": "number",
          "description": "Outstanding $10 late cancellation fee included in estimate"
        },
        "tcpaConsent": {
          "type": "boolean",
          "description": "Mandatory TCPA express consent for automated SMS communications"
        },
        "hipaaConsent": {
          "type": "boolean",
          "description": "Mandatory acknowledgement of HIPAA privacy practices"
        },
        "practitioner": {
          "type": "string",
          "description": "Assigned provider name",
          "maxLength": 100
        },
        "notes": {
          "type": "string",
          "description": "Patient sensitivities or clinical notes",
          "maxLength": 1000
        },
        "confirmationCode": {
          "type": "string",
          "description": "Short booking reference code",
          "maxLength": 20
        },
        "isNewPatient": {
          "type": "boolean",
          "description": "Whether patient is new to the practice"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "lastUpdated": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": [
        "patientName",
        "phoneNumber",
        "services",
        "appointmentDate",
        "timeSlot",
        "status",
        "totalCashEstimated",
        "tcpaConsent",
        "hipaaConsent",
        "createdAt"
      ]
    },
    "Patient": {
      "title": "Patient",
      "description": "Patient identity record indexed by normalized U.S. phone digits",
      "type": "object",
      "properties": {
        "phoneNumber": {
          "type": "string",
          "description": "Patient phone number string",
          "minLength": 10,
          "maxLength": 25
        },
        "fullName": {
          "type": "string",
          "description": "Patient full legal name",
          "minLength": 2,
          "maxLength": 100
        },
        "unpaidCancellationFee": {
          "type": "boolean",
          "description": "Flag indicating if the patient has an outstanding $10 late cancellation fee"
        },
        "feeAmount": {
          "type": "number",
          "description": "Outstanding cancellation fee amount (default 10.00)"
        },
        "lastUpdated": {
          "type": "string",
          "format": "date-time",
          "description": "Last modification server timestamp"
        }
      },
      "required": [
        "phoneNumber",
        "fullName",
        "unpaidCancellationFee",
        "feeAmount",
        "lastUpdated"
      ]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Append-only immutable audit record for HIPAA compliance and operational tracking",
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of event occurrence"
        },
        "action": {
          "type": "string",
          "description": "Event action type",
          "enum": ["CREATE", "CANCEL", "MARK_PAID", "STATUS_CHANGE"]
        },
        "performedBy": {
          "type": "string",
          "description": "Identifier of the actor (patient or staff UID/email)",
          "maxLength": 100
        },
        "patientId": {
          "type": "string",
          "description": "Associated patient phone number or record key",
          "maxLength": 50
        },
        "ipAddress": {
          "type": "string",
          "description": "Client IP address recorded at request time",
          "maxLength": 50
        },
        "details": {
          "type": "object",
          "description": "Structured event metadata"
        }
      },
      "required": [
        "timestamp",
        "action",
        "performedBy",
        "patientId"
      ]
    }
  },
  "firestore": {
    "/appointments/{appointmentId}": {
      "schema": "Appointment",
      "description": "Publicly submittable patient appointments managed by clinic staff"
    },
    "/patients/{patientId}": {
      "schema": "Patient",
      "description": "Patient records for late cancellation fee lookups"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Append-only compliance audit trail"
    }
  }
}
